<Project Sdk="Microsoft.NET.Sdk">
  <!-- 设置面板：net48 / WPF（XAML 在代码里，无需 markup compile）。
       编译：dotnet build src/PetSettings.csproj -c Release（在仓库根目录执行）
       产物：build\settings\PetSettings.exe（再复制到仓库根目录） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PetSettings</AssemblyName>
    <RootNamespace>PetSettings</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 版本信息：build.cmd 从 git tag 算出来传进来（-p:Version=...），
         没有 git / 没有 tag 时退回 2.0.0。与 Pet.csproj 用同一组数值。 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version Condition=" '$(Version)' == '' ">2.0.0</Version>
    <FileVersion Condition=" '$(FileVersion)' == '' ">$(Version)</FileVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Q Pet 设置</AssemblyTitle>
    <Product>Q Pet</Product>
    <Company>Q Pet contributors</Company>
    <Copyright>MIT License · 2026 Q Pet contributors</Copyright>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <ApplicationIcon>..\pet.ico</ApplicationIcon>
    <OutputPath>..\build\settings\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Settings.cs" />
    <!-- 纯函数（与 Pet.exe、Tests 共用，见 Core.cs 文件头注释） -->
    <Compile Include="Core.cs" />
    <Compile Include="KeyStats.cs" />
    <Compile Include="AppTreemap.cs" />
    <Compile Include="CharMap.cs" />
    <!-- 从 Settings.cs 拆出来的 partial 部分（2026-10-27）：主文件负责流程与配置，
         各页与主题/气泡/语音各自一个文件。顺序保持 Settings.cs 在前。 -->
    <Compile Include="Ui.cs" />
    <Compile Include="Bubble.cs" />
    <Compile Include="Voice.cs" />
    <Compile Include="PageAnim.cs" />
    <Compile Include="PageImport.cs" />
    <Compile Include="PageStats.cs" />
    <Compile Include="PageAbout.cs" />
    <!-- 精灵帧生成（原 sprites.py / anim_custom.py 的 C# 版，2026-10-29）：
         让「新建角色 / 改大小 / 换动画」不再需要 Python + Pillow。 -->
    <Compile Include="SpriteGen.cs" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <!-- 界面用的宽体几何英文字（Saira，SIL OFL 1.1，宽度轴切到 125%）。
         作为 Resource 打进 exe，XAML 里用 pack://application:,,,/Fonts/#Saira Wide 引用；
         不能指望系统字体——系统里没有宽体几何字，会退回普通字体，这个风格的辨识度就没了。 -->
    <Resource Include="..\Fonts\SairaWide-Medium.ttf" />
    <Resource Include="..\Fonts\SairaWide-SemiBold.ttf" />
    <Resource Include="..\Fonts\SairaWide-Bold.ttf" />
    <Resource Include="..\Fonts\SairaWide-ExtraBold.ttf" />
    <!-- 复合字体：拉丁用 Saira Wide、汉字用雅黑，见文件内注释 -->
    <Resource Include="..\Fonts\QPetUI.CompositeFont" />
  </ItemGroup>
  <ItemGroup>
    <!-- 同 Pet.csproj：没装 .NET Framework 4.8 开发包也能 dotnet build -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
