# build outputs
build/
obj/
bin/
dist/
__pycache__/
*.pyc
# 预编译产物只进 Releases，不进仓库：
# 仓库放源码，GitHub 的「下载 ZIP」拿到的是源码而不是成品，
# 成品统一从 https://github.com/xiezaji/q-pet/releases 下载（顺带能看下载量）。
*.exe

# runtime state
*.pid
*.log
pet-pos.txt
pet-status.txt
pet-status-*.txt
pet-stats*.txt

# 配置是**本机状态**，不是源码：
#   · pet-config.txt 由 make-pet-config.ps1 / 设置面板生成，Pet.exe 缺了会自动补一份最小配置
#   · pet-overrides.txt 是设置面板写的覆盖值
# 以前把它们提交进仓库，配上被忽略的 chars/<新角色>/ ⇒ 新克隆跑起来是「另一个角色」。
pet-config.txt
pet-overrides.txt
pet-char-time.txt
pet-settings-selftest.txt
pet-showpet-test.txt
se_err.txt
.wbapp_*.genie
pet-vol-cache/
screenshots/

# local assistant memory
.workbuddy/

# backups / archives
_旧命名备份/
*.rar
*.zip

# OS
Thumbs.db
desktop.ini
.DS_Store

# 新角色（未纳入版本管理）
chars/小祀/
chars/狗egg/
chars/病姐/
chars/魔芋爽/
web/assets/chars/小祀/
web/assets/chars/狗egg/
web/assets/chars/病姐/
web/assets/chars/魔芋爽/

# 本地浏览器 profile（开发调试用）
web/_ep/
web/_edgeprofile/

# 开发调试产物
web/_final.js
web/chk.png
web/final.png
web/shot*.png

# XAML 编辑用中间文件与本地备份（校验脚本已移到 tools/xamlgen.py）
_ref/*
